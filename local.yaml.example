# pandaspro 本地配置示例
# 复制为以下任一位置后填入你的 API Key（勿提交到 git）：
#   ./local.yaml
#   ~/.pandaspro/local.yaml
# 或通过环境变量 PANDASPRO_CONFIG 指定路径

ai:
  provider: deepseek
  api_key: sk-your-deepseek-api-key
  base_url: https://api.deepseek.com
  model: deepseek-chat

# 也可仅用环境变量（优先级更高）：
# export PANDASPRO_AI_API_KEY=sk-your-key
